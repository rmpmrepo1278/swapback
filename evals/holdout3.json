{
  "schema_version": 1,
  "purpose": "Third independent synthetic holdout for frozen dedicated-detector screening winner and current sm baseline. No authorized threshold, no population-rate or universal-readiness inference.",
  "provenance": {
    "author_role": "independent reviewer",
    "created_date": "2026-10-06",
    "executor_unseen_at_freeze": true,
    "data": "Invented values only; no user/private facts or functional keys. Reserved domains/IPs used where applicable."
  },
  "offsets": "Original Python Unicode codepoints, half-open [start,end).",
  "annotation_policy": {
    "coverage": "All expected codepoints must be covered. Typed coverage requires declared category at every expected position.",
    "utility": "Marked text survives verbatim in order with no source overlap. Every negative requires exact entire-text preservation. Report excess redaction outside expected union.",
    "categories": "SECRET includes contextual synthetic credentials/passport/national/licence IDs. SSN separate. Category mapping must be frozen before disclosure and truthful, not tuned to labels.",
    "policy": "Log disagreements separately; never edit frozen labels/text/offsets. Invalid-date negative is validation policy, not invitation to normalize corpus."
  },
  "evaluation_protocol": {
    "freeze": "Complete screening on already known material, select candidate, freeze candidate/baseline/adapters/evaluator/dependencies/model artifacts and mapping BEFORE disclosure. Run identical corpus once per frozen leg.",
    "metrics": "Per-case spans/leaks/typing/negative flags/utility/overredaction/refusal and per-category/tag counts; offsets and exact output preserve audit. Same methodology as first two corpora.",
    "gate": "No numeric threshold or crown criterion authorized. This is evidence for decision, not automatic activation. Small corpus not representative rate; candidate trained on similar public data cannot be ruled out.",
    "visibility": "Private author retention until parent confirms frozen screening leg(s); after disclosure all reuse permanently regression-only.",
    "resources": "Record startup/warm call/full request deadline+cleanup/peak memory separately; do not equate local direct inference with production hop budget."
  },
